# ─────────────────────────────────────────────────────────────────────────────
# LiveTally frontend environment template. Copy to `.env` and fill in values.
# `.env` is git-ignored — do not commit real company IDs.
#
# NOTE: Vite inlines VITE_* vars into the client bundle, so they are not secrets.
# Keep them out of git so the repository does not carry company identifiers.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the aman backend API (/api/v3).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v3

# Default company id used before the user selects one in the company switcher.
VITE_DEFAULT_COMPANY_ID=
